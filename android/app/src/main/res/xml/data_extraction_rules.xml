<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup rules (Android 12+). allowBackup=false in the manifest, but this
  is a defense-in-depth layer: even if a downstream build flips allowBackup, Health
  Connect sleep data, encrypted entries, and model weights are NEVER cloud-backed.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
  </device-transfer>
</data-extraction-rules>
